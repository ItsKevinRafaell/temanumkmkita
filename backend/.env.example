# Salin file ini menjadi .env dan isi nilainya
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/temanumkmkita
SECRET_KEY=ganti-dengan-secret-key-yang-kuat

# CRM Integration (kantor-teman)
CRM_API_URL=https://api.kantorteman.my.id
